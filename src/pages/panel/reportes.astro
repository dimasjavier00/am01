---
import Panel from '../../layouts/Panel.astro';
import Icon from '../../components/Icon.astro';
---
<Panel title="Reportes" heading="Reportes" subtitle="Rendimiento de tus publicaciones">
  <button slot="actions" type="button" data-export class="btn-ghost hidden sm:inline-flex"><Icon name="download" class="size-4" />Exportar CSV</button>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="inline-flex rounded-full border border-line bg-white p-1 text-sm" role="group" aria-label="Periodo">
      {[['3', '3 meses'], ['6', '6 meses'], ['12', '12 meses']].map(([v, l], i) => (
        <button type="button" data-range={v} aria-pressed={i === 1 ? 'true' : 'false'} class="rounded-full px-4 py-1.5 aria-pressed:bg-navy aria-pressed:text-white">{l}</button>
      ))}
    </div>
    <button type="button" data-export class="btn-ghost sm:hidden"><Icon name="download" class="size-4" />Exportar CSV</button>
  </div>

  <div class="mt-5 grid grid-cols-2 gap-4 xl:grid-cols-4" data-kpis></div>

  <div class="mt-6 grid gap-6 xl:grid-cols-[1.6fr_1fr]">
    <section class="card p-6" aria-labelledby="trend-title">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="trend-title" class="font-display text-lg font-bold">Vistas y consultas</h2>
        <div class="flex gap-4 text-xs">
          <span class="flex items-center gap-1.5"><span class="h-0.5 w-4 rounded bg-teal"></span>Vistas</span>
          <span class="flex items-center gap-1.5"><span class="h-0.5 w-4 rounded bg-fuchsia"></span>Consultas (×20)</span>
        </div>
      </div>
      <div class="mt-4" data-line></div>
    </section>

    <section class="card p-6" aria-labelledby="funnel-title">
      <h2 id="funnel-title" class="font-display text-lg font-bold">Embudo de ventas</h2>
      <p class="text-xs text-muted">Del anuncio al trato cerrado</p>
      <div class="mt-5 space-y-3" data-funnel></div>
    </section>
  </div>

  <div class="mt-6 grid gap-6 xl:grid-cols-2">
    <section class="card p-6" aria-labelledby="bars-title">
      <h2 id="bars-title" class="font-display text-lg font-bold">Consultas por vehículo</h2>
      <div class="mt-5 space-y-3" data-bars></div>
    </section>
    <section class="card overflow-hidden" aria-labelledby="table-title">
      <h2 id="table-title" class="p-6 pb-3 font-display text-lg font-bold">Detalle por publicación</h2>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[480px] text-sm">
          <thead class="border-y border-line bg-surface text-left font-condensed text-xs font-bold uppercase tracking-wider text-muted">
            <tr><th scope="col" class="px-6 py-2.5">Vehículo</th><th scope="col" class="px-3 py-2.5 text-right">Vistas</th><th scope="col" class="px-3 py-2.5 text-right">Consultas</th><th scope="col" class="px-6 py-2.5 text-right">Conversión</th></tr>
          </thead>
          <tbody class="divide-y divide-line" data-table></tbody>
        </table>
      </div>
    </section>
  </div>
</Panel>

<script>
  import { inventory, toast } from '../../lib/store';
  import { number, money } from '../../lib/format';
  import { iconSvg, type IconName } from '../../lib/icons';

  const months = ['Nov', 'Dic', 'Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct'];
  const views = [6200, 7100, 6800, 7900, 8400, 8100, 9300, 9900, 10400, 11200, 11800, 12400];
  const leads = [92, 104, 98, 121, 133, 128, 141, 150, 162, 171, 179, 186];
  const sales = [2, 3, 2, 4, 3, 4, 5, 4, 6, 5, 6, 7];
  let range = 6;

  const items = inventory.all();

  function kpis() {
    const sl = (a: number[]) => a.slice(-range);
    const sum = (a: number[]) => a.reduce((s, n) => s + n, 0);
    const prev = (a: number[]) => sum(a.slice(-range * 2, -range)) || sum(sl(a));
    const delta = (a: number[]) => Math.round(((sum(sl(a)) - prev(a)) / prev(a)) * 100);
    const cards: [string, string, number, IconName, string][] = [
      ['Vistas', number(sum(sl(views))), delta(views), 'eye', 'bg-navy-50 text-navy'],
      ['Consultas', number(sum(sl(leads))), delta(leads), 'chat', 'bg-fuchsia-50 text-fuchsia'],
      ['Ventas cerradas', String(sum(sl(sales))), delta(sales), 'badge', 'bg-teal-50 text-teal'],
      ['Tiempo promedio de venta', `${range === 3 ? 16 : range === 6 ? 18 : 21} días`, -8, 'clock', 'bg-amber-50 text-amber-600'],
    ];
    document.querySelector('[data-kpis]')!.innerHTML = cards
      .map(([label, value, d, icon, color], i) => {
        const good = i === 3 ? d < 0 : d >= 0;
        return `<div class="card p-5"><div class="flex items-start justify-between"><p class="text-sm text-muted">${label}</p><span class="grid size-9 place-items-center rounded-lg ${color}">${iconSvg(icon, 'size-[18px]')}</span></div>
        <p class="mt-2 font-display text-3xl font-extrabold">${value}</p>
        <p class="mt-1 text-xs ${good ? 'text-teal-deep' : 'text-fuchsia-deep'}">${d > 0 ? '▲' : '▼'} ${Math.abs(d)}% vs. periodo anterior</p></div>`;
      })
      .join('');
  }

  function line() {
    const v = views.slice(-range), l = leads.slice(-range).map((n) => n * 20), m = months.slice(-range);
    const W = 640, H = 240, P = { l: 44, r: 12, t: 12, b: 28 };
    const max = Math.ceil(Math.max(...v, ...l) / 2000) * 2000;
    const x = (i: number) => P.l + (i * (W - P.l - P.r)) / Math.max(1, m.length - 1);
    const y = (n: number) => P.t + (1 - n / max) * (H - P.t - P.b);
    const path = (a: number[]) => a.map((n, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(n).toFixed(1)}`).join('');
    const grid = [0, 0.25, 0.5, 0.75, 1].map((f) => `<line x1="${P.l}" x2="${W - P.r}" y1="${y(max * f)}" y2="${y(max * f)}" stroke="#e5e9ef"/><text x="${P.l - 8}" y="${y(max * f) + 4}" text-anchor="end" font-size="11" fill="#6b7280">${(max * f) / 1000}k</text>`).join('');
    const labels = m.map((t, i) => `<text x="${x(i)}" y="${H - 8}" text-anchor="middle" font-size="11" fill="#6b7280">${t}</text>`).join('');
    const dots = (a: number[], c: string) => a.map((n, i) => `<circle cx="${x(i)}" cy="${y(n)}" r="3.5" fill="#fff" stroke="${c}" stroke-width="2"><title>${number(c === '#129FB1' ? n : n / 20)}</title></circle>`).join('');
    document.querySelector('[data-line]')!.innerHTML = `<svg viewBox="0 0 ${W} ${H}" class="h-auto w-full" role="img" aria-label="Vistas de ${number(v[0])} a ${number(v[v.length - 1])}; consultas de ${leads.slice(-range)[0]} a ${leads[leads.length - 1]}">
      <defs><linearGradient id="fillT" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#129FB1" stop-opacity=".22"/><stop offset="1" stop-color="#129FB1" stop-opacity="0"/></linearGradient></defs>
      ${grid}${labels}
      <path d="${path(v)}L${x(v.length - 1)},${y(0)}L${x(0)},${y(0)}Z" fill="url(#fillT)"/>
      <path d="${path(v)}" fill="none" stroke="#129FB1" stroke-width="2.5" stroke-linejoin="round"/>
      <path d="${path(l)}" fill="none" stroke="#C5299B" stroke-width="2.5" stroke-dasharray="6 4" stroke-linejoin="round"/>
      ${dots(v, '#129FB1')}${dots(l, '#C5299B')}
    </svg>`;
  }

  function funnel() {
    const v = views.slice(-range).reduce((a, b) => a + b, 0);
    const l = leads.slice(-range).reduce((a, b) => a + b, 0);
    const s = sales.slice(-range).reduce((a, b) => a + b, 0);
    const steps: [string, number, string][] = [
      ['Vistas del anuncio', v, 'bg-navy'],
      ['Consultas', l, 'bg-teal'],
      ['Pruebas de manejo', Math.round(l * 0.31), 'bg-aqua'],
      ['Ventas', s, 'bg-fuchsia'],
    ];
    document.querySelector('[data-funnel]')!.innerHTML = steps
      .map(([label, n, c], i) => {
        const w = i === 0 ? 100 : Math.max(8, 100 - i * 24);
        const rate = i === 0 ? '' : `<span class="text-xs text-muted">${((n / steps[i - 1][1]) * 100).toFixed(1)}%</span>`;
        return `<div><div class="flex justify-between text-sm"><span>${label}</span><span class="flex items-center gap-2">${rate}<strong>${number(n)}</strong></span></div>
          <div class="mt-1 h-3 rounded-full bg-surface"><div class="h-full rounded-full ${c}" style="width:${w}%"></div></div></div>`;
      })
      .join('');
  }

  function vehiclesBreakdown() {
    const list = [...items].sort((a, b) => b.leads - a.leads);
    const max = Math.max(...list.map((v) => v.leads), 1);
    document.querySelector('[data-bars]')!.innerHTML = list
      .slice(0, 7)
      .map((v) => `<div class="grid grid-cols-[minmax(0,9rem)_1fr_2.5rem] items-center gap-3 text-sm">
        <span class="truncate">${v.brand} ${v.model}</span>
        <span class="h-2.5 rounded-full bg-surface"><span class="block h-full rounded-full bg-teal-gradient" style="width:${(v.leads / max) * 100}%"></span></span>
        <span class="text-right font-medium">${v.leads}</span></div>`)
      .join('');
    document.querySelector('[data-table]')!.innerHTML = list
      .map((v) => `<tr><td class="px-6 py-2.5"><p class="font-medium">${v.brand} ${v.model} ${v.year}</p><p class="text-xs text-muted">${money(v.price)} · ${v.status}</p></td>
        <td class="px-3 py-2.5 text-right">${number(v.views)}</td><td class="px-3 py-2.5 text-right">${v.leads}</td>
        <td class="px-6 py-2.5 text-right">${v.views ? ((v.leads / v.views) * 100).toFixed(1) : '0.0'}%</td></tr>`)
      .join('');
  }

  function render() { kpis(); line(); funnel(); }
  document.querySelectorAll<HTMLButtonElement>('[data-range]').forEach((b) =>
    b.addEventListener('click', () => {
      range = Number(b.dataset.range);
      document.querySelectorAll('[data-range]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    }),
  );

  document.querySelectorAll('[data-export]').forEach((b) =>
    b.addEventListener('click', () => {
      const rows = [['Vehículo', 'Año', 'Precio (L)', 'Estado', 'Vistas', 'Consultas'], ...items.map((v) => [`${v.brand} ${v.model}`, v.year, v.price, v.status, v.views, v.leads])];
      const csv = '﻿' + rows.map((r) => r.map((c) => `"${String(c).replace(/"/g, '""')}"`).join(',')).join('\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      a.download = `automarket-reporte-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      URL.revokeObjectURL(a.href);
      toast('Reporte exportado');
    }),
  );

  render();
  vehiclesBreakdown();
</script>
