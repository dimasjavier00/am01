---
import Base from '../layouts/Base.astro';
import Isotipo from '../components/Isotipo.astro';
---
<Base title="Página no encontrada">
  <section class="container-am flex flex-col items-center py-24 text-center">
    <Isotipo class="size-24 animate-[spin_6s_linear_infinite] motion-reduce:animate-none" />
    <p class="mt-8 font-display text-6xl font-extrabold text-navy">404</p>
    <h1 class="mt-2 text-2xl font-bold">Esta ruta no lleva a ningún lado</h1>
    <p class="mt-2 max-w-md text-muted">La página que buscas no existe o fue movida. Pero tenemos muchos vehículos esperándote.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-ghost">Ir al inicio</a>
      <a href="/vehiculos/" class="btn-primary">Ver vehículos</a>
    </div>
  </section>
</Base>
