---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Isotipo from '../components/Isotipo.astro';

const primary = [
  ['Azul acua', '#129FB1', 'bg-teal', 'text-white'],
  ['Gris', '#414141', 'bg-ink', 'text-white'],
];
const secondary = [
  ['Blanco', '#FFFFFF', 'bg-white ring-1 ring-inset ring-line', 'text-ink'],
  ['Fucsia', '#C5299B', 'bg-fuchsia', 'text-white'],
  ['Azul marino', '#001A70', 'bg-navy', 'text-white'],
  ['Aguamarina', '#2CCCD3', 'bg-aqua', 'text-navy-deep'],
];
const tones = [
  ['Fucsia profundo', '#AF0F7D', 'bg-fuchsia-deep'],
  ['Petróleo', '#00829B', 'bg-teal-deep'],
  ['Índigo', '#00005A', 'bg-navy-deep'],
];
---
<Base title="Identidad de marca" description="Manual de identidad corporativa de Automarket aplicado a la web: logotipo, colores, tipografías y degradados.">
  <section class="relative overflow-hidden bg-brand-gradient py-20 text-white">
    <div class="absolute inset-y-0 right-0 w-1/2 stripe-band opacity-15" aria-hidden="true"></div>
    <div class="container-am relative">
      <p class="font-condensed text-sm font-bold uppercase tracking-[0.18em] text-aqua">Manual de identidad corporativa</p>
      <h1 class="mt-3 max-w-2xl text-4xl font-normal text-white sm:text-5xl"><strong class="font-extrabold">La marca</strong> detrás de Automarket</h1>
      <Logo variant="white" class="mt-10 h-auto w-full max-w-xl" />
    </div>
  </section>

  <section class="container-am grid gap-6 py-16 lg:grid-cols-2">
    <div class="card p-8">
      <p class="eyebrow">A · Logotipo completo</p>
      <div class="mt-6 grid place-items-center rounded-2xl border border-dashed border-line px-6 py-12"><Logo class="h-auto w-full max-w-md" /></div>
      <p class="mt-4 text-sm leading-relaxed text-muted">Versión principal. Se usa como primera opción en cualquier pieza: portada, encabezado del sitio y papelería. Respeta siempre su área de protección.</p>
    </div>
    <div class="card p-8">
      <p class="eyebrow">B · Isotipo</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-8 rounded-2xl border border-dashed border-line px-6 py-8">
        <Isotipo class="size-28" />
        <div class="grid size-28 place-items-center rounded-2xl bg-navy"><Isotipo variant="white" class="size-20" /></div>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-muted">Versión mínima: la llanta con la estrella-A. Se usa cuando el logotipo ya apareció, como ícono del sitio, avatar y sellos.</p>
    </div>
  </section>

  <section class="bg-surface py-16">
    <div class="container-am">
      <h2 class="text-3xl font-bold"><strong>Colores</strong> <span class="font-normal">institucionales</span></h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {primary.map(([name, hex, bg, fg]) => (
          <div class:list={['flex h-40 flex-col justify-end rounded-2xl p-5', bg, fg]}><p class="font-condensed text-sm uppercase tracking-widest opacity-80">Principal</p><p class="font-display text-xl font-bold">{name}</p><p class="font-mono text-sm">{hex}</p></div>
        ))}
      </div>
      <div class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {secondary.map(([name, hex, bg, fg]) => (
          <div class:list={['flex h-32 flex-col justify-end rounded-2xl p-4', bg, fg]}><p class="font-display font-bold">{name}</p><p class="font-mono text-xs">{hex}</p></div>
        ))}
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {tones.map(([name, hex, bg]) => (
          <div class:list={['flex h-20 items-end justify-between rounded-2xl p-4 text-white', bg]}><p class="font-display text-sm font-bold">{name}</p><p class="font-mono text-xs">{hex}</p></div>
        ))}
      </div>
      <h3 class="mt-12 font-condensed text-base font-bold uppercase tracking-wider text-fuchsia">Degradados</h3>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <div class="h-24 rounded-2xl bg-brand-gradient"></div>
        <div class="h-24 rounded-2xl bg-teal-gradient"></div>
        <div class="h-24 rounded-2xl bg-stripes"></div>
      </div>
    </div>
  </section>

  <section class="container-am py-16">
    <h2 class="text-3xl font-bold"><strong>Tipografías</strong></h2>
    <div class="mt-8 grid gap-6 lg:grid-cols-3">
      <div class="card p-6"><p class="eyebrow">Títulos</p><p class="mt-3 font-display text-4xl text-navy"><strong>Open</strong> Sans</p><p class="mt-3 text-sm text-muted">Negrilla en la primera palabra o línea del título.</p></div>
      <div class="card p-6"><p class="eyebrow">Subtítulos</p><p class="mt-3 font-condensed text-4xl font-light text-navy">Roboto Condensed</p><p class="mt-3 text-sm text-muted">Light en subtítulos grandes, negrilla en los pequeños.</p></div>
      <div class="card p-6"><p class="eyebrow">Cuerpo de texto</p><p class="mt-3 font-sans text-4xl text-navy">Roboto</p><p class="mt-3 text-sm text-muted">Arial como alternativa cuando Roboto no esté disponible.</p></div>
    </div>
  </section>

  <section class="container-am pb-20">
    <h2 class="text-3xl font-bold"><strong>Aplicaciones</strong></h2>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <img src="/img/brand/mockup-paper.webp" alt="Logotipo de Automarket impreso en papelería" class="aspect-[3/2] w-full rounded-2xl object-cover" loading="lazy" />
      <img src="/img/brand/mockup-backpack.webp" alt="Mochila con los colores y el logotipo de Automarket" class="aspect-[3/2] w-full rounded-2xl object-cover" loading="lazy" />
    </div>
  </section>
</Base>
