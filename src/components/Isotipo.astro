---
// Isotipo oficial: llanta gris con la estrella-A en azul acua.
interface Props {
  variant?: 'color' | 'white';
  class?: string;
}
const { variant = 'color', class: className = 'size-10' } = Astro.props;
const white = variant === 'white';
---
<svg viewBox="0 0 100 100" class={className} aria-hidden="true">
  {white ? (
    <>
      <path fill="#fff" fill-rule="evenodd" d="M50 0a50 50 0 1 1 0 100A50 50 0 0 1 50 0Zm0 12.7a37.3 37.3 0 1 0 0 74.6 37.3 37.3 0 0 0 0-74.6Z" />
      <circle cx="50" cy="50" r="32.5" fill="none" stroke="#fff" stroke-width="1.4" />
    </>
  ) : (
    <>
      <circle cx="50" cy="50" r="50" fill="#414141" />
      <circle cx="50" cy="50" r="37.3" fill="#fff" />
      <circle cx="50" cy="50" r="32.5" fill="none" stroke="#414141" stroke-width="1.4" />
    </>
  )}
  <path fill={white ? '#fff' : '#129FB1'} fill-rule="evenodd" d="M50 20 68.3 73.4 50 60.7 32.2 73.4Z M50 41.7 44.9 57 50 53.4 55.1 57Z" />
  <path fill={white ? '#fff' : '#129FB1'} d="M22.4 37.1h18.3l-3.4 11.2Z M59.3 37.1h18.3l-15.2 11.2Z" />
</svg>
