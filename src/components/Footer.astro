---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const cols = [
  { title: 'Comprar', links: [['Todos los vehículos', '/vehiculos/'], ['SUV', '/vehiculos/?tipo=SUV'], ['Sedanes', '/vehiculos/?tipo=Sed%C3%A1n'], ['Eléctricos e híbridos', '/vehiculos/?combustible=El%C3%A9ctrico,H%C3%ADbrido'], ['Favoritos', '/favoritos/']] },
  { title: 'Vender', links: [['Publicar vehículo', '/panel/publicar/'], ['Por qué Automarket', '/vender/'], ['Planes y precios', '/planes/'], ['Panel de vendedor', '/panel/']] },
  { title: 'Automarket', links: [['Cómo funciona', '/#como-funciona'], ['Identidad de marca', '/marca/'], ['Términos y condiciones', '/legal/'], ['Privacidad', '/legal/#privacidad']] },
];
---
<footer class="relative overflow-hidden bg-brand-gradient text-white">
  <div class="absolute inset-y-0 right-0 hidden w-1/3 stripe-band opacity-25 lg:block" aria-hidden="true"></div>
  <div class="h-1 bg-aqua"></div>
  <div class="container-am relative grid gap-12 py-14 lg:grid-cols-[1.3fr_2fr]">
    <div class="max-w-sm">
      <Logo variant="white" class="h-7 w-auto" />
      <p class="mt-5 text-sm leading-relaxed text-white/80">
        El mercado de vehículos de Honduras. Conectamos a vendedores y compradores en tiempo real, con publicaciones verificadas y herramientas para concesionarios.
      </p>
      <dl class="mt-6 space-y-2 text-sm">
        <div class="flex items-center gap-2"><Icon name="phone" class="size-4 text-aqua" /><dt class="sr-only">Teléfono</dt><dd><a href="tel:+50433010630" class="hover:text-aqua">+504 3301-0630</a></dd></div>
        <div class="flex items-center gap-2"><Icon name="mail" class="size-4 text-aqua" /><dt class="sr-only">Correo</dt><dd><a href="mailto:hola@automarket.hn" class="hover:text-aqua">hola@automarket.hn</a></dd></div>
        <div class="flex items-center gap-2"><Icon name="clock" class="size-4 text-aqua" /><dt class="sr-only">Horario</dt><dd>Lun – Vie 8:00 – 17:00 · Sáb 8:00 – 12:00</dd></div>
      </dl>
      <div class="mt-6 flex gap-2">
        <a href="#" class="grid size-9 place-items-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Facebook"><Icon name="facebook" class="size-4" /></a>
        <a href="#" class="grid size-9 place-items-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Instagram"><Icon name="instagram" class="size-4" /></a>
        <a href="https://wa.me/50433010630" class="grid size-9 place-items-center rounded-full bg-white/10 hover:bg-white/20" aria-label="WhatsApp"><Icon name="chat" class="size-4" /></a>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
      {cols.map((col) => (
        <div>
          <p class="font-condensed text-sm font-bold uppercase tracking-[0.14em] text-aqua">{col.title}</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            {col.links.map(([label, href]) => (
              <li><a href={href} class="text-white/80 transition hover:text-white">{label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <div class="relative border-t border-white/10">
    <div class="container-am flex flex-col gap-2 py-5 text-xs text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} Automarket. Todos los derechos reservados.</p>
      <p>Hecho en Honduras · Versión 2.0 (prototipo de interfaz)</p>
    </div>
  </div>
</footer>
