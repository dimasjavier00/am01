---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const nav = [
  { href: '/vehiculos/', label: 'Comprar' },
  { href: '/vender/', label: 'Vender' },
  { href: '/planes/', label: 'Planes' },
  { href: '/#como-funciona', label: 'Cómo funciona' },
];
const isActive = (href: string) => href !== '/#como-funciona' && path.startsWith(href.replace(/\/$/, ''));
---
<div class="h-1 bg-[linear-gradient(90deg,var(--color-aqua),var(--color-teal)_35%,var(--color-fuchsia))]"></div>
<header class="sticky top-0 z-40 border-b border-line bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/80">
  <div class="container-am flex h-16 items-center gap-3 sm:gap-6">
    <a href="/" class="shrink-0" aria-label="Automarket, inicio">
      <Logo class="h-[17px] w-auto sm:h-6" />
    </a>

    <nav aria-label="Principal" class="hidden flex-1 md:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li class={item.href.startsWith('/#') ? 'hidden lg:block' : undefined}>
            <a
              href={item.href}
              class:list={[
                'whitespace-nowrap rounded-lg px-3 py-2 font-condensed text-[15px] font-bold transition hover:text-teal',
                isActive(item.href) ? 'text-teal' : 'text-ink',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1 sm:gap-2">
      <a href="/favoritos/" class="relative hidden size-10 place-items-center rounded-lg sm:grid text-ink hover:bg-surface hover:text-fuchsia" aria-label="Favoritos">
        <Icon name="heart" />
        <span data-fav-count class="absolute right-1 top-1 hidden min-w-4 rounded-full bg-fuchsia px-1 text-center text-[10px] font-bold leading-4 text-white"></span>
      </a>

      <div data-auth="guest" class="hidden items-center gap-2 sm:flex">
        <a href="/login/" class="btn-ghost whitespace-nowrap border-transparent px-3">Iniciar sesión</a>
        <a href="/panel/publicar/" class="btn-accent whitespace-nowrap"><Icon name="plus" class="size-4" /><span class="hidden lg:inline">Publicar vehículo</span><span class="lg:hidden">Publicar</span></a>
      </div>

      <div data-auth="user" class="relative">
        <button type="button" data-user-btn class="flex items-center gap-2 rounded-full border border-line p-1 hover:border-teal sm:pr-3" aria-haspopup="menu" aria-expanded="false">
          <span data-user-initials class="grid size-8 place-items-center rounded-full bg-teal-gradient text-xs font-bold text-white">DR</span>
          <span data-user-name class="hidden max-w-32 truncate text-sm font-medium lg:inline">Mi cuenta</span>
          <Icon name="chevron-down" class="hidden size-4 text-muted sm:block" />
        </button>
        <div data-user-menu role="menu" class="absolute right-0 mt-2 hidden w-56 overflow-hidden rounded-xl border border-line bg-white py-1 shadow-lift">
          <a role="menuitem" href="/panel/" class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-surface"><Icon name="dashboard" class="size-4 text-teal" />Mi panel</a>
          <a role="menuitem" href="/panel/inventario/" class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-surface"><Icon name="list" class="size-4 text-teal" />Mi inventario</a>
          <a role="menuitem" href="/panel/publicar/" class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-surface"><Icon name="plus" class="size-4 text-teal" />Publicar vehículo</a>
          <a role="menuitem" href="/favoritos/" class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-surface"><Icon name="heart" class="size-4 text-teal" />Favoritos</a>
          <hr class="my-1 border-line" />
          <button role="menuitem" type="button" data-logout class="flex w-full items-center gap-2 px-4 py-2.5 text-left text-sm text-fuchsia-deep hover:bg-surface"><Icon name="logout" class="size-4" />Cerrar sesión</button>
        </div>
      </div>

      <button type="button" data-menu-open class="grid size-10 place-items-center rounded-lg text-ink hover:bg-surface md:hidden" aria-label="Abrir menú" aria-controls="mobile-menu" aria-expanded="false">
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-white md:hidden">
    <nav aria-label="Móvil" class="container-am flex flex-col py-3">
      {nav.map((item) => (
        <a href={item.href} class="rounded-lg px-2 py-3 font-condensed text-lg font-bold text-ink hover:text-teal">{item.label}</a>
      ))}
      <a href="/favoritos/" class="rounded-lg px-2 py-3 font-condensed text-lg font-bold text-ink hover:text-teal">Favoritos</a>
      <div data-auth="guest" class="mt-2 grid grid-cols-2 gap-2 border-t border-line pt-4">
        <a href="/login/" class="btn-ghost">Iniciar sesión</a>
        <a href="/registro/" class="btn-primary">Crear cuenta</a>
      </div>
      <div data-auth="user" class="mt-2 grid grid-cols-2 gap-2 border-t border-line pt-4">
        <a href="/panel/" class="btn-primary">Mi panel</a>
        <button type="button" data-logout class="btn-ghost">Cerrar sesión</button>
      </div>
    </nav>
  </div>
</header>

<script>
  import { session, favorites, toast } from '../lib/store';

  function render() {
    const user = session.get();
    if (user) document.documentElement.dataset.session = 'user';
    else delete document.documentElement.dataset.session;
    if (user) {
      const initials = user.name.split(' ').map((p) => p[0]).slice(0, 2).join('').toUpperCase();
      document.querySelectorAll('[data-user-initials]').forEach((el) => (el.textContent = initials));
      document.querySelectorAll('[data-user-name]').forEach((el) => (el.textContent = user.name.split(' ')[0]));
    }
    const count = favorites.all().length;
    document.querySelectorAll<HTMLElement>('[data-fav-count]').forEach((el) => {
      el.textContent = String(count);
      el.classList.toggle('hidden', count === 0);
    });
  }
  render();
  window.addEventListener('am:store', render);
  window.addEventListener('storage', render);

  const userBtn = document.querySelector<HTMLButtonElement>('[data-user-btn]');
  const userMenu = document.querySelector<HTMLElement>('[data-user-menu]');
  userBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = userMenu!.classList.toggle('hidden') === false;
    userBtn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', () => {
    userMenu?.classList.add('hidden');
    userBtn?.setAttribute('aria-expanded', 'false');
  });

  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const mobile = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    const open = mobile!.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });

  document.querySelectorAll('[data-logout]').forEach((b) =>
    b.addEventListener('click', () => {
      session.clear();
      toast('Sesión cerrada. ¡Vuelve pronto!', 'info');
      if (location.pathname.startsWith('/panel')) setTimeout(() => (location.href = '/'), 600);
    }),
  );
</script>
